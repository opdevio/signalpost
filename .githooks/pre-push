#!/usr/bin/env sh
# Check every reachable commit before publishing to any product remote.
set -eu
# Anything heading for GitHub must go over the business SSH alias, and that
# alias must really authenticate as the business account.
#
# Checking the gh token is not enough: gh can be the business account while the
# push itself travels over a personal SSH key, because the remote URL decides
# the transport identity and gh never sees it. The commit checks below would all
# pass and the push would still arrive as somebody else.
case "$2" in
    *github.com*|*github-opdevio*)
        case "$2" in
            git@github-opdevio:*) ;;
            *) echo 'pre-push: push to GitHub must use git@github-opdevio:<owner>/<repo>.git' >&2
               echo "pre-push: got $2" >&2
               echo 'pre-push: github.com resolves to the operator personal key' >&2
               exit 1 ;;
        esac
        # -n is load-bearing: git feeds the ref list on stdin, and ssh reads
        # stdin by default. Without it ssh swallows the refs, the loop below
        # gets nothing, and every commit identity check silently passes.
        who="$(ssh -n -o BatchMode=yes -o ConnectTimeout=10 -T git@github-opdevio 2>&1                | sed -n 's/^Hi \([A-Za-z0-9-]*\).*/\1/p')"
        [ "$who" = opdevio ] || {
            echo "pre-push: the alias authenticates as '${who:-nobody}', not opdevio" >&2; exit 1;
        }
        command -v gh >/dev/null 2>&1 && {
            login="$(gh api --hostname github.com user --jq .login </dev/null 2>/dev/null || true)"
            [ -z "$login" ] || [ "$login" = opdevio ] || {
                echo 'pre-push: switch gh to the dedicated business account' >&2; exit 1;
            }
        } ;;
esac
want='opdev io <hello@opdevio.xyz>'
# Read the whole ref list before any network call can touch stdin.
refs="$(cat)"
# Only commits the destination does not already hold are being published.
# Exclude what `git ls-remote` reports for the destination itself (the
# authoritative answer, not a local remote-tracking ref that anyone can move),
# so a contribution branch on a fork of someone else's repo is judged by our
# commits alone. A destination we cannot list, or an empty one, excludes
# nothing and the whole reachable history is checked.
known="$(git ls-remote "$2" 2>/dev/null </dev/null | while read -r sha _; do
    git cat-file -e "$sha^{commit}" 2>/dev/null && printf '^%s\n' "$sha"
done | sort -u)" || known=
printf '%s\n' "$refs" | while read -r local_ref local_sha remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac
    object="$local_sha"
    while [ "$(git cat-file -t "$object")" = tag ]; do
        tag="$(git cat-file tag "$object")"
        tagger="$(printf '%s\n' "$tag" | sed -n '/^$/q; s/^tagger //p')"
        case "$tagger" in "$want "*) ;; *) echo 'pre-push: tagger must use the business identity' >&2; exit 1 ;; esac
        if printf '%s\n' "$tag" | grep -qE '^-----BEGIN .*SIGNATURE-----'; then
            echo 'pre-push: signed tags are not allowed' >&2; exit 1
        fi
        object="$(printf '%s\n' "$tag" | sed -n '1s/^object //p')"
    done
    [ "$(git cat-file -t "$object")" = commit ] || {
        echo 'pre-push: only refs resolving to commits are allowed' >&2; exit 1;
    }
    # shellcheck disable=SC2086
    commits="$(git rev-list "$object" $known)"
    for commit in $commits; do
        identity="$(git show -s --format='%an <%ae>|%cn <%ce>' "$commit")"
        [ "$identity" = "$want|$want" ] || {
            echo 'pre-push: history contains a non-business author or committer' >&2; exit 1;
        }
        headers="$(git cat-file commit "$commit" | sed '/^$/q')"
        if printf '%s\n' "$headers" | grep -qE '^gpgsig(-sha256)? '; then
            echo 'pre-push: signed commits are not allowed' >&2; exit 1
        fi
    done
done
